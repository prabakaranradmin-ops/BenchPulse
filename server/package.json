{
  "name": "ar-quest-trail-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node-pg-migrate up --envPath .env",
    "migrate:down": "node-pg-migrate down --envPath .env",
    "migrate:create": "node-pg-migrate create -j sql",
    "job:purge-location-history": "tsx src/jobs/purgeLocationHistory.ts",
    "grant-admin": "tsx src/jobs/grantAdmin.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:field-test": "tsx src/jobs/seedFieldTestTrail.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.3",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  }
}
