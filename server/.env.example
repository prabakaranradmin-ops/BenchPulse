PORT=3000
DATABASE_URL=postgres://localhost:5432/ar_quest_trail
JWT_SECRET=change-me

# SR-PRIV-01 retention window for raw location fixes. Default 90 `[ASSUMED — confirm]`.
# LOCATION_HISTORY_RETENTION_DAYS=90

# SR-ADMIN-01 water / inside-a-building warnings query OpenStreetMap's Overpass API when a trail
# is checked or published. `off` disables them; OVERPASS_URLS (comma-separated) replaces the
# default public servers, e.g. with your own Overpass instance.
# LANDCOVER_CHECKS=off
# OVERPASS_URLS=https://overpass.example.org/api/interpreter

# Admin web tool (/admin/). A Cesium ion token turns its map into 3D terrain + OSM buildings;
# without one it is a flat OpenStreetMap map. ADMIN_WEB_DIR overrides where the built tool lives
# (default: ../admin-web/dist, i.e. `npm run build` in admin-web/).
# CESIUM_ION_TOKEN=
# ADMIN_WEB_DIR=

# Optional: enables the ST-2.7 integration test, which runs the real migrations and SQL against
# a throwaway schema in this database. Unset, `npm test` skips it. See README.md for a
# one-line container.
# TEST_DATABASE_URL=postgres://arquest:arquest@localhost:55432/ar_quest_trail
