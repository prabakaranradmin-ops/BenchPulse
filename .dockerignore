# Build context is the repo root (server/Dockerfile). Only server/ and admin-web/ sources are
# needed; everything else is excluded so the context stays small and no secrets ride along.
*
!server/package.json
!server/package-lock.json
!server/tsconfig.json
!server/src
!server/migrations
!admin-web

# Within what's allowed back in above.
**/node_modules
**/dist
**/.env
**/.env.*
**/*.log
admin-web/public/cesium
server/src/**/*.test.ts
