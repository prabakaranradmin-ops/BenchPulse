<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds the Unity project's Core scripts outside Unity, so they can be compiled and tested
    on any machine with the .NET SDK. The sources are NOT copied: they live in
    ../../Assets/Scripts/Core and Unity compiles the very same files.

    netstandard2.1 + C# 9 is Unity's own profile (2021.2 through Unity 6). Pinning it here means
    a C# 10 feature or a .NET API Unity lacks fails *this* build, instead of failing for the
    first time inside the Editor.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>ArQuestTrail.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unity side: the com.unity.nuget.newtonsoft-json package provides the same library. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
